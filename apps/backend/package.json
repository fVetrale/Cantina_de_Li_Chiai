{
  "name": "@winery/backend",
  "version": "0.0.1",
  "private": true,
  "description": "Winery e-commerce backend — Medusa v2 headless commerce engine",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "medusa start",
    "lint": "eslint src integration-tests medusa-config.ts jest.config.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "db:generate": "medusa db:generate",
    "db:migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "clean": "rm -rf .medusa dist"
  },
  "dependencies": {
    "@medusajs/cache-redis": "2.22.2",
    "@medusajs/cli": "2.22.2",
    "@medusajs/event-bus-redis": "2.22.2",
    "@medusajs/framework": "2.22.2",
    "@medusajs/medusa": "2.22.2",
    "dotenv": "^16.4.5",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@medusajs/admin-sdk": "2.22.2",
    "@medusajs/test-utils": "2.22.2",
    "@swc/core": "1.16.21",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "jest": "29.7.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.72.1"
  }
}
